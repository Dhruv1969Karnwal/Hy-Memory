# ============================================================
# HY Memory Environment Variable Configuration Example
# Copy to .env and fill in the real values
#
# Only the common, currently effective settings are listed here; see docs/env_reference.md for the full list.
# ============================================================

# ── Core Configuration ──
# MEMORY_DATA_DIR=~/.hy_memory          # Root directory for local data, cache and logs
# MEMORY_LOG_DIR=                        # Unified log root directory; pipeline JSONL defaults to {DATA_DIR}/logs/pipeline
# MEMORY_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
# MEMORY_LOG_FORMAT=text                 # text | json
# HY_MEMORY_SERVER_HOST=127.0.0.1
# HY_MEMORY_SERVER_PORT=19527

# ── Logging, Trace and History (Table Persistence Switches) ──
# MEMORY_PIPELINE_TRACE_ENABLED=true     # pipeline_logs table (intermediate results of the LLM call chain, for the Inspector). JSONL file logging is always written and is not affected by this switch
# MEMORY_MEMORY_OPERATIONS_ENABLED=false # memory_operations table (ADD/UPDATE audit log for the memory base). Off by default
# MEMORY_LOG_LLM_CONTENT=false           # Dangerous debug switch; only true lets logs record the full LLM prompt/response

# ── LLM (Memory Extraction/Processing, OpenAI-Compatible Protocol) ──
MEMORY_LLM_MODEL=deepseek-chat
MEMORY_LLM_API_KEY=sk-your-key
MEMORY_LLM_BASE_URL=https://api.deepseek.com
# MEMORY_LLM_TEMPERATURE=0.1
# MEMORY_LLM_OMIT_TEMPERATURE=false      # true: temperature is never sent at all in the request
# MEMORY_LLM_MAX_TOKENS=1024
# MEMORY_AGENT_MAX_TOKENS=2000
# MEMORY_LLM_TIMEOUT=180
# MEMORY_LLM_MAX_RETRIES=5
# MEMORY_LLM_RETRY_DELAY=1.0
# MEMORY_LLM_EXTRA_HEADERS={}            # JSON object with extra HTTP headers
# MEMORY_LLM_EXTRA_BODY={}               # JSON object with extra request body fields

# ── Embedding (Vectorization, OpenAI-Compatible Protocol) ──
MEMORY_EMBEDDER_MODEL=text-embedding-v4
MEMORY_EMBEDDER_API_KEY=sk-your-key
MEMORY_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_DIMS=1024
# MEMORY_EMBEDDER_TIMEOUT=15
# MEMORY_EMBEDDER_MAX_RETRIES=2
# MEMORY_EMBEDDER_RETRY_DELAY=0.3
# MEMORY_EMBEDDER_EXTRA_HEADERS={}
# MEMORY_EMBEDDER_EXTRA_BODY={}

# ── Vector Store ──
# Options: chroma (default, local files) | qdrant | faiss
MEMORY_VECTOR_STORE=chroma
# MEMORY_COLLECTION_NAME=agent_memories
# MEMORY_VECTOR_API_KEY=                 # API key for the remote vector backend
# MEMORY_PERSIST_DIR=                    # Local persistence directory for the vector store

# --- Qdrant ---
# MEMORY_VECTOR_HOST=localhost
# MEMORY_VECTOR_PORT=6333

# ── Graph Store (Off by Default) ──
# MEMORY_ENABLE_GRAPH=false              # Only takes effect on pro; forced off on lite, forced on on ultra
# MEMORY_GRAPH_PROVIDER=kuzu             # kuzu (default) | neo4j
# MEMORY_GRAPH_DB_PATH=                  # Kuzu database path
# --- Neo4j ---
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ── Cache ──
# MEMORY_CACHE_BACKEND=sqlite           # sqlite (default) | mysql
# MEMORY_CACHE_DB_PATH=                  # SQLite file path (default {DATA_DIR}/data/cache.db)
# MEMORY_MYSQL_HOST=localhost
# MEMORY_MYSQL_PORT=3306
# MEMORY_MYSQL_USER=root
# MEMORY_MYSQL_PASSWORD=
# MEMORY_MYSQL_DATABASE=hy_memory
# MEMORY_MYSQL_POOL_SIZE=10
# MEMORY_MYSQL_POOL_RECYCLE=3600

# ── Processing Mode ──
# MEMORY_MODE=pro                         # lite | pro | ultra

# ── Coding Memory (Separate Productivity / Coding Pipeline, On by Default) ──
# A pipeline separate from chat memory: on the write side messages are classified, and for coding scenes a "task -> solution" pair is extracted into sqlite;
# on the read side, scene=productivity is served from this store (see the query rewrite / working memory fusion logic).
# Per-client configuration is also possible through from_config({"coding": {...}}) (keys are the names below without the MEMORY_CODING_ prefix, lowercased).
# MEMORY_CODING_ENABLED=true                    # false: disable the coding pipeline, every add goes through the chat pipeline
# MEMORY_CODING_DB_PATH=                        # coding_memory.db path (default {DATA_DIR}/data/coding_memory.db)
# MEMORY_CODING_TOOL_RESULT_MAX_BYTES=2048      # Maximum bytes per tool_result before truncation
# MEMORY_CODING_VERBATIM_FALLBACK_ENABLED=false # Whether to store the original text as a fact when the model returns nothing; off by default so that tool traces do not leak
# MEMORY_EXTRACT_HISTORY_TURNS=5                 # Number of earlier user turns injected into the Extractor besides the current write

# ── Write Pipeline Switches ──
# RECONCILE_ENABLED=true                  # false: skip reconcile and insert the extractor results straight into the VDB
# MEMORY_ENABLE_SEARCH_QUERY=false        # true: an LLM expands the search query before reconcile (off by default, search directly with hybrid)
# MEMORY_FEW_SHOT_ENABLED=false           # true: attach few-shot examples to the Extractor and Reconcile prompts (off by default)
# MEMORY_ENABLE_INTENTION=true            # false: do not extract or write L7 Intention

# ── System 2 (ultra mode) ──
# SWEEPER_ENABLED=true                    # false: skip the cross-domain sweeper
# MEMORY_SUMMARY_ENABLED_IN_SYS2=false    # true: the S2 preprocess scan includes L3_SUMMARY
# MEMORY_EVOLING_BALANCED_CATALOG_ENABLED=false  # Ultra evolve: select exact entries from the active/latest L2 into a per-domain catalog, off by default
# MEMORY_EVOLING_BALANCED_CATALOG_MAX_FACTS=120  # Maximum number of L2 entries the write side reviews
# MEMORY_EVOLING_BALANCED_CATALOG_CONTENT_CHARS=180 # Per-L2 truncation in the write-side prompt; the visible catalog keeps the full exact L2
# MEMORY_EVOLING_BALANCED_CATALOG_MAX_TOKENS=512 # Maximum output tokens for catalog index selection
# MEMORY_EVOLING_SPECIFIC_SUPPLEMENT_ENABLED=false # Ultra evolve: generate an exact-evidence supplement
# MEMORY_USER_PROFILE_BALANCED_CATALOG_ENABLED=false # get_user_profile: attach the active balanced catalog, off by default
# MEMORY_USER_PROFILE_SPECIFIC_SUPPLEMENT_ENABLED=false # get_user_profile: attach the active specific supplement, off by default

# ── Cross-domain Sweeper Thresholds ──
# MEMORY_CROSS_DOMAIN_ENABLE=true         # Internal sweeper switch
# MEMORY_CROSS_DOMAIN_MIN_BASICS=5        # Minimum number of schemas for the collision scan (beh_embed is not subject to this limit)
# MEMORY_CROSS_DOMAIN_BEH_THRESHOLD=0.70  # Behavior-similarity collision threshold
# MEMORY_CROSS_DOMAIN_CON_THRESHOLD=0.60  # Content-similarity collision threshold (only values below it count as cross-domain)

# ── Reader and Local Rerank ──
# HY_MEMORY_READER=legacy                 # legacy | hybrid
# MEMORY_LOCAL_RERANK_ENABLED=false       # Local cross-encoder rerank; off by default
# MEMORY_LOCAL_RERANK_MODEL=nreimers/mmarco-mMiniLMv2-L6-H384-v1
# MEMORY_LOCAL_RERANK_POOL_FACTOR=3
# MEMORY_LOCAL_RERANK_MAX_LENGTH=512
# MEMORY_LOCAL_RERANK_BATCH_SIZE=16
# MEMORY_LOCAL_RERANK_DEVICE=auto

# ── Query Rewrite (Search-side Coreference Resolution + Time Span, Client-level, Off by Default) ──
# Targets queries that are missing a time span or a referent, such as "that thing I mentioned yesterday" or "the important stuff we discussed last week". When enabled, search makes one
# extra LLM call that rewrites the query into a concise one from the queries context and turns relative time into a created_after lower-bound filter. When working
# memory (coding.enable) is on as well, the two merge into a single LLM call (classification + rewrite), so chat scenes never pay for two LLM calls.
# MEMORY_ENABLE_QUERY_REWRITE=false       # Only controls default input plus explicit queries=[...]; a single default query is always zero-LLM
# MEMORY_QUERY_REWRITE_MAX_CHARS=1000     # Length guard for default multi-query rewrite; agentic uses an internal bounded view

# ── Memory Strength (Ranking by Time Decay Over Idle Time, Off by Default) ──
# strength = (1 + log(access_count)) * exp(-idle_days / tau), multiplied into the normal channel score
# MEMORY_RECALL_STRENGTH_ENABLED=false    # Master switch (off by default): strength reranking and the access write-back only happen once it is on
# MEMORY_RECALL_STRENGTH_TAU=180          # Decay time constant, days
# MEMORY_RECALL_ACCESS_TRACKING=true      # Write access_count/last_accessed_at back after search (gated by the master switch)

# ── Entity Store (Off by Default) ──
# Only controls whether the write side maintains a separate entity collection for L2_FACT; the current reader does not consume that collection directly.
# For older data, client.build_entity_store(user_id) builds it afterwards; requires spaCy en_core_web_sm.
# MEMORY_ENTITY_STORE_ENABLED=false
